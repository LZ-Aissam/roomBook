generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  STUDENT
  ADMIN
}

model Room {
  id       Int    @id @default(autoincrement())
  name     String @unique
  capacity Int
  bookings Booking[]
}

model Booking {
  id       Int      @id @default(autoincrement())
  userId   Int
  startsAt DateTime
  endsAt   DateTime
  roomId   Int
  room     Room     @relation(fields: [roomId], references: [id])
  user     User     @relation(fields: [userId], references: [id])
}

model User {
  id       Int    @id @default(autoincrement())
  email    String @unique
  passwordHash String
  role     Role   @default(STUDENT)
  bookings Booking[]
}
